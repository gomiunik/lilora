#ifndef _LORAWAN_CREDENTIALS_H
#define _LORAWAN_CREDENTIALS_H

// =============================================================================
// LoRaWAN OTAA Credentials
// =============================================================================
//
// IMPORTANT: Copy this file to lorawan_credentials.h and fill in your keys!
// The lorawan_credentials.h file should be added to .gitignore
//
// Get these values from your LoRaWAN network server:
// - ChirpStack: Applications > Your App > Devices > Your Device > Keys (OTAA)
// - TTN: Applications > Your App > End devices > Your Device > Overview
//
// KEY FORMAT: All values must be in MSB (Most Significant Byte) format
// =============================================================================

// JoinEUI (AppEUI) - 8 bytes as uint64_t
// In TTN this is called AppEUI, in ChirpStack it's JoinEUI
// For development/testing, you can often use all zeros: 0x0000000000000000
#define LORAWAN_JOIN_EUI  0x0000000000000000

// DevEUI - 8 bytes as uint64_t
// Unique device identifier - get from network server or device label
#define LORAWAN_DEV_EUI   0x0000000000000000

// AppKey - 16 bytes as comma-separated hex values
// Application key for OTAA join (LoRaWAN 1.0.x uses same key as NwkKey)
#define LORAWAN_APP_KEY   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
                          0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00

// NwkKey - 16 bytes as comma-separated hex values
// Network key (for LoRaWAN 1.0.x, use same value as AppKey)
#define LORAWAN_NWK_KEY   0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
                          0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00

// =============================================================================
// Convert to variables used by the firmware
// =============================================================================

uint64_t joinEUI = LORAWAN_JOIN_EUI;
uint64_t devEUI  = LORAWAN_DEV_EUI;
uint8_t appKey[] = { LORAWAN_APP_KEY };
uint8_t nwkKey[] = { LORAWAN_NWK_KEY };

#endif // _LORAWAN_CREDENTIALS_H
